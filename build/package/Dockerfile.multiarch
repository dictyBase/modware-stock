# Build Stage
FROM --platform=$BUILDPLATFORM golang:1.25-alpine3.23 AS builder

ARG TARGETOS
ARG TARGETARCH

# Install upx for binary compression (amd64 only — not reliable on arm64)
RUN if [ "$TARGETARCH" = "amd64" ]; then apk add --no-cache upx; fi

WORKDIR /app

# Copy dependency files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY cmd/ ./cmd/
COPY internal/ ./internal/

# Build binary with stripped symbols
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build \
    -ldflags="-s -w" \
    -o /bin/modware-stock \
    ./cmd/modware-stock

# Compress binary (amd64 only)
RUN if [ "$TARGETARCH" = "amd64" ]; then upx -9 -q /bin/modware-stock; fi

# Runtime Stage
FROM gcr.io/distroless/static-debian12

LABEL org.opencontainers.image.source=https://github.com/dictyBase/modware-stock

COPY --from=builder /bin/modware-stock /bin/modware-stock

ENTRYPOINT ["/bin/modware-stock"]
